# Copy to .env and edit. All settings are prefixed AT_ (see config.py).

AT_LOG_LEVEL=INFO

# Tool modules add their own settings as fields on Settings in config.py.
# Nothing reads the environment directly.

# --- adb_management ---------------------------------------------------------
# Paths to the Android host tools. Bare names are resolved through PATH.
AT_ADB_PATH=adb
AT_EMULATOR_PATH=emulator

# sdkmanager and avdmanager ship under the SDK root and are usually NOT on
# PATH. Leave unset and they are looked for under
# <sdk root>/cmdline-tools/latest/bin/.
# AT_SDKMANAGER_PATH=
# AT_AVDMANAGER_PATH=

# The SDK root. Also read from ANDROID_SDK_ROOT or ANDROID_HOME, which the
# Android tooling sets itself -- the one setting that answers to an unprefixed
# name. AT_ wins where both are set.
# AT_ANDROID_SDK_ROOT=/home/you/Android/Sdk

# Extra flags added to every emulator launch, e.g. "-no-window -no-audio" on a
# headless machine. Empty means the emulator's own defaults.
AT_EMULATOR_LAUNCH_ARGS=

# How long an adb call may take.
AT_ADB_COMMAND_TIMEOUT_SECONDS=30

# How long adb_run_device waits for a launched AVD to attach and finish
# booting, and how often it checks while waiting.
AT_EMULATOR_BOOT_TIMEOUT_SECONDS=300
AT_EMULATOR_BOOT_POLL_INTERVAL_SECONDS=2

# System images run to gigabytes, so this is deliberately long.
AT_SDKMANAGER_TIMEOUT_SECONDS=3600

# avdmanager contacts the remote package repository before it will create
# anything, even when the image is already on disk.
AT_AVDMANAGER_TIMEOUT_SECONDS=600

# --- appium_module ----------------------------------------------------------
# Drives any attached Android device -- emulator or physical -- through Appium.
# Device ids come from the android module; nothing here lists devices.

# The Appium CLI. A bare name is resolved through PATH, which is where an
# nvm-managed install lives. Node is reported by appium_check_environment and
# npm is used only to install drivers.
AT_APPIUM_PATH_BIN=appium
AT_APPIUM_NODE_PATH=node
AT_APPIUM_NPM_PATH=npm

# Where the Appium server listens. Loopback deliberately: an Appium server
# drives every attached device with no authentication of any kind, and binding
# it to 0.0.0.0 hands that to the local network.
AT_APPIUM_SERVER_HOST=127.0.0.1
AT_APPIUM_SERVER_PORT=4723

# Appium 3 serves at the root. Set /wd/hub to point at an Appium 1 server.
AT_APPIUM_SERVER_BASE_PATH=/

# Launch a server when nothing is listening, and kill it on shutdown. Set to
# false to require one already running -- an absent server is then an error
# rather than a spawn.
AT_APPIUM_MANAGE_SERVER=true

# Where a managed server's log is written. Unset keeps it in memory and
# surfaces only the tail, on failure.
# AT_APPIUM_SERVER_LOG_PATH=

# How long to wait for a launched server to answer /status, and how often to
# check while waiting.
AT_APPIUM_SERVER_START_TIMEOUT_SECONDS=60
AT_APPIUM_SERVER_POLL_INTERVAL_SECONDS=0.5

# How long an `appium` CLI call (-v, driver list) may take.
AT_APPIUM_COMMAND_TIMEOUT_SECONDS=60

# Driver installs pull from the npm registry and are measured in minutes.
AT_APPIUM_DRIVER_INSTALL_TIMEOUT_SECONDS=900

# How long to wait for a session to be created. A cold emulator or a real
# device over USB is slow, and failing early just hides a working setup.
AT_APPIUM_SESSION_STARTUP_TIMEOUT_SECONDS=180

# How long the server keeps an idle session alive. Long, because a session here
# waits on a human or a model deciding what to do next.
AT_APPIUM_NEW_COMMAND_TIMEOUT_SECONDS=600

# How long a single gesture or query may take.
AT_APPIUM_INTERACTION_TIMEOUT_SECONDS=60

# UiAutomator2 drives both emulators and physical Android devices; they differ
# only in the serial. iOS would need XCUITest and a macOS host.
AT_APPIUM_PLATFORM_NAME=Android
AT_APPIUM_AUTOMATION_NAME=UiAutomator2
AT_APPIUM_DRIVER_NAME=uiautomator2
